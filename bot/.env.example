# ==============================================================================
# 李志全系音乐电报机器人 - 环境变量配置模板 (bot/.env.example)
# 使用说明：复制本文件为 .env，并填入您自己的真实配置项
# ==============================================================================

# 1. Telegram 机器人核心凭据 (必填，从 Telegram @BotFather 获取)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. 音乐档案专属频道 ID (必填，例如 -100xxxxxxxxxx 或 @频道名)
CHANNEL_ID=-1001234567890

# 3. SQLite 核心数据库文件存储路径 (默认 music.db)
DB_PATH=music.db

# 4. Telegram Mini App 黑胶播放器入口控制 (默认 false 显示普通命令菜单；设为 true 时挂载小程序入口按钮)
ENABLE_MINIAPP=false
MINIAPP_URL=https://lz.17013344.xyz
