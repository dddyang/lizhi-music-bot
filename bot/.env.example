# ==============================================================================
# 李志全系音乐电报机器人 - 环境变量配置模板 (bot/.env.example)
# 使用说明：复制本文件为 .env，并填入您自己的真实配置项
# ==============================================================================

# 1. Telegram 机器人核心凭据 (必填，从 Telegram @BotFather 获取)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. 音乐档案专属频道 ID (必填，例如: -100xxxxxxxxxx)
CHANNEL_ID=-1001234567890

# 3. Telegram MTProto 开发者凭据 (用于流媒体拉流或大文件传输，从 https://my.telegram.org 获取)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# 4. SQLite 核心数据库文件存储路径 (默认 music.db)
DB_PATH=music.db

# 5. 局域网软路由 / 边缘服务器运维凭据 (选填，用于自动化运维与部署脚本)
R2S_HOST=192.168.100.1
R2S_USER=root
R2S_PASSWORD=your_r2s_ssh_password

# 6. 流媒体中继安全鉴权密钥 (选填)
STREAM_SECRET=your_custom_stream_secret_key

# 7. 本地音频归档与转码路径 (用于 auto_uploader.py 批量入库)
MUSIC_ROOT=Z:\音乐\李志
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
